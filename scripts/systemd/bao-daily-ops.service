[Unit]
Description=bao daily ops (upstream sync + issue triage)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/putao/code/rust/bao
EnvironmentFile=-/home/putao/code/rust/bao/.claude/daily-ops/mode.conf
Environment=MODE=dry-run
Environment=PATH=/home/putao/.local/bin:/home/putao/.cargo/bin:/usr/local/bin:/usr/bin:/usr/local/sbin:/usr/sbin
TimeoutStartSec=100min
ExecStart=/home/putao/code/rust/bao/scripts/daily-ops.sh
